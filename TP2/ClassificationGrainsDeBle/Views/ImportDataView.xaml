<!-- Views/ImportDataView.xaml -->
<UserControl x:Class="ClassificationGrainsDeBle_WPF.Views.ImportDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Train File Section -->
        <GroupBox Grid.Row="0" Header="📊 Fichier d'entraînement" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="5">
                    <Button Command="{Binding LoadTrainCommand}" 
                            Content="📂 Charger" 
                            Width="100" 
                            Margin="0,0,10,0"
                            DockPanel.Dock="Left"/>
                    <TextBox Text="{Binding TrainFilePath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding TrainGrains.Count, StringFormat='Nombre de grains: {0}'}" 
                           Margin="5,5,0,5"
                           FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>
        
        <!-- Test File Section -->
        <GroupBox Grid.Row="1" Header="🧪 Fichier de test" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="5">
                    <Button Command="{Binding LoadTestCommand}" 
                            Content="📂 Charger" 
                            Width="100" 
                            Margin="0,0,10,0"
                            DockPanel.Dock="Left"/>
                    <TextBox Text="{Binding TestFilePath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding TestGrains.Count, StringFormat='Nombre de grains: {0}'}" 
                           Margin="5,5,0,5"
                           FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>
        
        <!-- DataGrid for Train Data -->
        <TabControl Grid.Row="2" Margin="0,10">
            <TabItem Header="Données d'entraînement">
                <DataGrid ItemsSource="{Binding TrainGrains}" 
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="LightGray"/>
            </TabItem>
            <TabItem Header="Données de test">
                <DataGrid ItemsSource="{Binding TestGrains}" 
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="LightGray"/>
            </TabItem>
        </TabControl>
        
        <!-- Validate Button -->
        <Button Grid.Row="3" 
                Command="{Binding ValidateDataCommand}"
                Content="✅ Valider les données"
                HorizontalAlignment="Center"
                Width="200"
                Height="35"
                Margin="0,15,0,0"
                FontWeight="Bold"
                Background="LightGreen"/>
    </Grid>
</UserControl>