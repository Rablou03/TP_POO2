<!-- Views/ClassifierConfigView.xaml -->
<UserControl x:Class="ClassificationGrainsDeBle_WPF.Views.ClassifierConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Border Background="White" CornerRadius="10" Padding="20">
        <StackPanel HorizontalAlignment="Center" Width="400">
            <TextBlock Text="⚙️ Configuration du Classifieur k-NN"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>
            
            <!-- K Value Selection -->
            <GroupBox Header="Paramètre k (nombre de voisins)" Margin="0,0,0,20">
                <StackPanel Margin="10">
                    <TextBlock Text="Valeur de k :" Margin="0,0,0,5"/>
                    <Slider Minimum="1" 
                            Maximum="30" 
                            Value="{Binding KValue}"
                            TickFrequency="1"
                            TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"
                            Margin="0,5,0,5"/>
                    <TextBlock Text="{Binding KValue, StringFormat='k = {0}'}" 
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </GroupBox>
            
            <!-- Distance Selection -->
            <GroupBox Header="Métrique de distance" Margin="0,0,0,20">
                <StackPanel Margin="10">
                    <RadioButton GroupName="Distance" 
                                 Content="📐 Euclidienne" 
                                 IsChecked="{Binding SelectedDistance, ConverterParameter='Euclidienne', Converter={StaticResource StringToBoolConverter}}"
                                 Margin="0,5"/>
                    <RadioButton GroupName="Distance" 
                                 Content="🏙️ Manhattan" 
                                 IsChecked="{Binding SelectedDistance, ConverterParameter='Manhattan', Converter={StaticResource StringToBoolConverter}}"
                                 Margin="0,5"/>
                    
                    <Border Background="#F0F0F0" CornerRadius="5" Padding="10" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="📖 Explication" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="• Euclidienne: distance géométrique classique (√∑(xi-yi)²)" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock Text="• Manhattan: somme des différences absolues (∑|xi-yi|)" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>
            
            <!-- Current Config Display -->
            <Border Background="#E8F4FD" CornerRadius="5" Padding="10" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="📌 Configuration actuelle" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding KValue, StringFormat='k : {0}'}" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding SelectedDistance, StringFormat='Distance : {0}'}" FontFamily="Consolas"/>
                </StackPanel>
            </Border>
            
            <!-- Apply Button -->
            <Button Command="{Binding ApplyConfigCommand}"
                    Content="💾 Appliquer la configuration"
                    Height="40"
                    FontWeight="Bold"
                    Background="#4CAF50"
                    Foreground="White"
                    Cursor="Hand"/>
        </StackPanel>
    </Border>
</UserControl>