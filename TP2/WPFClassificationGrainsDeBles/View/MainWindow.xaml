<Window x:Class="WPFClassificationGrainsDeBles.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:WPFClassificationGrainsDeBles.ViewModels"
        Title="Classification des grains de blé - k-NN"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--MENU HORIZONTAL EN HAUT -->
        <Border BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1"
                Background="#F5F5F5">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">

                <StackPanel Orientation="Horizontal" Margin="10,5">

                    <!-- ACCUEIL -->
                    <Button Command="{Binding NavigateHomeCommand}"
                            Height="40"
                            Width="130"
                            Margin="5,0"
                            ToolTip="Accueil">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Image/home-button_icon-icons.com_72700.ico"
                                   Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Accueil" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                               Width="1" Background="Gray" Margin="5,0"/>

                    <!-- IMPORTER -->
                    <Button Command="{Binding NavigateImportCommand}"
                            Height="40" Width="130" Margin="5,0"
                            ToolTip="Importer les données">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Image/import_120260.ico"
                                   Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Importer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- CONFIGURER K -->
                    <Button Command="{Binding NavigateKConfigCommand}"
                            Height="40" Width="130" Margin="5,0"
                            ToolTip="Choisir la valeur de k">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Image/3844439-gear-setting-settings-wheel_110294.ico"
                                   Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Configurer k" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- DISTANCE -->
                    <Button Command="{Binding NavigateDistanceConfigCommand}"
                            Height="40" Width="130" Margin="5,0"
                            ToolTip="Choisir la distance">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Image/calculate_equals_icon_194844.ico"
                                   Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Distance" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                               Width="1" Background="Gray" Margin="5,0"/>

                    <!-- ENTRAINER -->
                    <Button Command="{Binding TrainCommand}"
                            Height="40" Width="130" Margin="5,0"
                            ToolTip="Entraîner le modèle">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Image/run_icon-icons.com_61189.ico"
                                   Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Entraîner" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- TESTER -->
                    <Button Command="{Binding TestCommand}"
                            Height="40" Width="130" Margin="5,0"
                            ToolTip="Tester le modèle">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Image/PixelKit_0034_Waiting-for-Validation_37731.ico"
                                   Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Tester" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                               Width="1" Background="Gray" Margin="5,0"/>

                    <!-- RESULTATS -->
                    <Button Command="{Binding NavigateResultsCommand}"
                            Height="40" Width="130" Margin="5,0"
                            ToolTip="Voir les résultats">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Image/findings_icon-icons.com_67772.ico"
                                   Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Résultats" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- HISTORIQUE -->
                    <Button Command="{Binding NavigateHistoryCommand}"
                            Height="40" Width="130" Margin="5,0"
                            ToolTip="Voir l'historique">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Image/archive_120061.ico"
                                   Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Historique" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                               Width="1" Background="Gray" Margin="5,0"/>

                    <!-- QUITTER -->
                    <Button Command="{Binding QuitCommand}"
                            Height="40" Width="130" Margin="5,0"
                            ToolTip="Quitter l'application">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Image/4213459-common-door-exit-logout-out-signout_115411.ico"
                                   Width="20" Height="20" Margin="0,0,5,0"/>
                            <TextBlock Text="Quitter" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="15">

                <!-- EN-TÊTE -->
                <Border Background="#E3F2FD" Padding="10" CornerRadius="5" Margin="0,0,0,15">
                    <TextBlock Text="{Binding CurrentTitle}"
                               FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#1565C0"/>
                </Border>

                <!-- PAGE D'ACCUEIL -->
                <Border Background="#E8F5E9" Padding="30" CornerRadius="10"
                        Margin="0,0,0,15" Visibility="{Binding ShowWelcome}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Classification des grains de blé avec k-NN"
                                   FontSize="18" HorizontalAlignment="Center"
                                   Margin="0,10,0,0" Foreground="#1565C0"/>
                        <TextBlock Text="Utilisez le menu ci-dessus pour naviguer dans l'application"
                                   FontSize="14" HorizontalAlignment="Center"
                                   Margin="0,20,0,0" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <!-- IMPORTATION -->
                <GroupBox Header="1. Importer les données"
                          Visibility="{Binding ShowImport}">
                    <StackPanel Margin="10">

                        <TextBlock Text="Fichier d'entraînement (train.csv):" FontWeight="Bold"/>
                        <Grid Margin="0,5,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TrainPath}" IsReadOnly="True" Background="#F9F9F9"/>
                            <Button Content="Parcourir" Command="{Binding BrowseTrainCommand}"
                                    Grid.Column="1" Margin="5,0,0,0" Width="80" Height="30"/>
                        </Grid>

                        <TextBlock Text="Fichier de test (test.csv):" FontWeight="Bold" Margin="0,10,0,0"/>
                        <Grid Margin="0,5,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TestPath}" IsReadOnly="True" Background="#F9F9F9"/>
                            <Button Content="Parcourir" Command="{Binding BrowseTestCommand}"
                                    Grid.Column="1" Margin="5,0,0,0" Width="80" Height="30"/>
                        </Grid>

                        <Button Content="Importer les données" Command="{Binding ImportCommand}"
                                Height="40" Margin="0,10" FontWeight="Bold"
                                Background="#4CAF50" Foreground="White"/>

                        <TextBlock Text="Statut:" FontWeight="Bold" Margin="0,10,0,0"/>
                        <Border Background="#F0F0F0" Padding="5" CornerRadius="3">
                            <TextBlock Text="{Binding ImportStatus}" TextWrapping="Wrap" FontSize="11"/>
                        </Border>

                    </StackPanel>
                </GroupBox>

                <!-- CONFIGURATION K -->
                <GroupBox Header="2. Choisir la valeur de k"
                          Visibility="{Binding ShowKConfig}" Margin="0,15,0,0">
                    <StackPanel Margin="10">

                        <TextBlock Text="Veuillez configurer k avant de choisir la distance"
                                   FontWeight="Bold" Foreground="#1565C0"
                                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="k = " FontSize="20" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox Text="{Binding KValue, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80" Height="40" TextAlignment="Center"
                                     FontSize="16" Margin="10,0"/>
                        </StackPanel>

                        <TextBlock Text="(valeur entre 1 et 30)" FontSize="12"
                                   Foreground="Gray" HorizontalAlignment="Center" Margin="0,5"/>

                        <Button Content="Valider k et continuer"
                                Command="{Binding ValidateKAndContinueCommand}"
                                Height="40" Width="200" Margin="0,15"
                                HorizontalAlignment="Center"
                                Background="#2196F3" Foreground="White" FontWeight="Bold"/>

                    </StackPanel>
                </GroupBox>

                <!-- DISTANCE -->
                <GroupBox Header="3. Choisir la distance"
                          Visibility="{Binding ShowDistanceConfig}" Margin="0,15,0,0">
                    <StackPanel Margin="10">

                        <TextBlock Text="Choisissez la distance pour la classification"
                                   FontWeight="Bold" Foreground="#1565C0"
                                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <RadioButton Content="Euclidienne" IsChecked="{Binding IsEuclidienne}"
                                     Margin="0,10" FontSize="14" GroupName="Distance"/>
                        <RadioButton Content="Manhattan" IsChecked="{Binding IsManhattan}"
                                     Margin="0,10" FontSize="14" GroupName="Distance"/>

                        <Button Content="Valider la distance et continuer"
                                Command="{Binding ValidateDistanceAndContinueCommand}"
                                Height="40" Width="250" Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                Background="#FF9800" Foreground="White" FontWeight="Bold"/>

                    </StackPanel>
                </GroupBox>

                <!-- ENTRAINEMENT -->
                <GroupBox Header="4. Entraîner le modèle"
                          Visibility="{Binding ShowTrain}" Margin="0,15,0,0">
                    <StackPanel Margin="10">

                        <TextBlock Text="Configuration actuelle :" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Border Background="#F0F0F0" Padding="10" CornerRadius="5" Margin="0,0,0,15">
                            <TextBlock Text="{Binding CurrentConfigText}"
                                       FontFamily="Consolas" FontSize="12"/>
                        </Border>

                        <Button Content="Entraîner le modèle" Command="{Binding TrainCommand}"
                                Height="45" Margin="0,5"
                                Background="#2196F3" Foreground="White"
                                FontWeight="Bold" FontSize="14"/>

                    </StackPanel>
                </GroupBox>

                <!-- TEST -->
                <GroupBox Header="5. Tester le modèle"
                          Visibility="{Binding ShowTest}" Margin="0,15,0,0">
                    <StackPanel Margin="10">

                        <!-- ↓ SECTION AUTEUR AJOUTÉE ICI -->
                        <Border Background="#FFF8E1" Padding="10"
                                CornerRadius="5" Margin="0,0,0,15"
                                BorderBrush="#FFB300" BorderThickness="1">
                            <StackPanel>

                                <TextBlock Text="Choisir un auteur pour cette expérience"
                                           FontWeight="Bold" Foreground="#E65100"
                                           Margin="0,0,0,10"/>

                                <Button Content="Charger les utilisateurs depuis l'API"
                                        Command="{Binding ChargerUtilisateursCommand}"
                                        Height="35" Width="260"
                                        HorizontalAlignment="Left"
                                        Background="#FF9800" Foreground="White"
                                        FontWeight="Bold" Margin="0,0,0,10"/>

                                <TextBlock Text="Sélectionner un auteur :"
                                           FontWeight="Bold" Margin="0,0,0,5"/>

                                <ComboBox ItemsSource="{Binding Utilisateurs}"
                                          SelectedItem="{Binding UtilisateurSelectionne}"
                                          DisplayMemberPath="NomComplet"
                                          Width="300"
                                          HorizontalAlignment="Left"
                                          Height="30"
                                          Margin="0,0,0,10"/>

                                <TextBlock FontStyle="Italic" Foreground="#2E7D32">
                                    <TextBlock.Text>
                                        <Binding Path="UtilisateurSelectionne.NomComplet"
                                                 StringFormat="✔ Auteur sélectionné : {0}"/>
                                    </TextBlock.Text>
                                </TextBlock>

                            </StackPanel>
                        </Border>
                        <!-- ↑ FIN SECTION AUTEUR -->

                        <Button Content="Tester le modèle" Command="{Binding TestCommand}"
                                Height="45" Margin="0,5"
                                Background="#FF9800" Foreground="White"
                                FontWeight="Bold" FontSize="14"/>

                    </StackPanel>
                </GroupBox>

                <!-- RESULTATS -->
                <GroupBox Header="Résultats" Margin="0,15,0,0"
                          Visibility="{Binding ShowResults}">
                    <TextBox Text="{Binding ResultText}"
                             TextWrapping="Wrap" FontFamily="Consolas"
                             MinHeight="200" MaxHeight="300"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True" Padding="10" Background="#FAFAFA"/>
                </GroupBox>

                <!-- HISTORIQUE -->
                <GroupBox Header="Historique des expériences"
                          Margin="0,15,0,15" Visibility="{Binding ShowHistory}">
                    <ListBox ItemsSource="{Binding HistoriqueList}"
                             MinHeight="150" MaxHeight="200"
                             Margin="5" FontFamily="Consolas"/>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>