<UserControl x:Class="WPFClassificationGrainsDeBles.Views.HistoriqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" Width="500">

            <TextBlock Text="Historique des expériences"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 25"/>

            <GroupBox Header="Exécutions précédentes">
                <ListBox ItemsSource="{Binding Historique}"
                         Margin="10"
                         Height="350"/>
            </GroupBox>

        </StackPanel>
    </Grid>
</UserControl>
