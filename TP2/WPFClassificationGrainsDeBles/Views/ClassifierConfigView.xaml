<UserControl x:Class="WPFClassificationGrainsDeBles.Views.ClassifierConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" Width="400">

            <TextBlock Text="Configuration du Classifieur k-NN"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 25"/>

            <GroupBox Header="Paramètre k (nombre de voisins)" Margin="0 0 0 20">
                <StackPanel Margin="10">
                    <TextBlock Text="Valeur de k :" Margin="0 0 0 5"/>
                    <Slider Minimum="1"
                            Maximum="30"
                            Value="{Binding KValue}"
                            TickFrequency="1"
                            TickPlacement="BottomRight"
                            IsSnapToTickEnabled="True"
                            Margin="0 5"/>
                    <TextBlock Text="{Binding KValue, StringFormat='k = {0}'}"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Métrique de distance" Margin="0 0 0 20">
                <StackPanel Margin="10">
                    <RadioButton GroupName="Distance"
                                 Content="Euclidienne"
                                 IsChecked="{Binding SelectedDistance, ConverterParameter='Euclidienne', Converter={StaticResource StringToBoolConverter}}"
                                 Margin="0 5"/>

                    <RadioButton GroupName="Distance"
                                 Content="Manhattan"
                                 IsChecked="{Binding SelectedDistance, ConverterParameter='Manhattan', Converter={StaticResource StringToBoolConverter}}"
                                 Margin="0 5"/>

                    <StackPanel Margin="0 15 0 0">
                        <TextBlock Text="Explication" FontWeight="Bold" Margin="0 0 0 5"/>
                        <TextBlock Text="• Euclidienne : distance géométrique classique (√∑(xi-yi)²)"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="• Manhattan : somme des différences absolues (∑|xi-yi|)"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0 5 0 0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Configuration actuelle" Margin="0 0 0 20">
                <StackPanel Margin="10">
                    <TextBlock Text="{Binding KValue, StringFormat='k : {0}'}"/>
                    <TextBlock Text="{Binding SelectedDistance, StringFormat='Distance : {0}'}"/>
                </StackPanel>
            </GroupBox>

            <Button Command="{Binding ApplyConfigCommand}"
                    Content="Appliquer la configuration"
                    Height="40"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>
