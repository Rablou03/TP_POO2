<UserControl x:Class="WPFClassificationGrainsDeBles.Views.ImportDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" Width="400">

            <TextBlock Text="Importation des données"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0 0 0 25"/>

            <GroupBox Header="Sélection du fichier" Margin="0 0 0 20">
                <StackPanel Margin="10">
                    <TextBlock Text="{Binding Status}" Margin="0 0 0 10"/>
                    <Button Content="Importer un fichier CSV"
                            Command="{Binding ImportCommand}"
                            Height="40"
                            FontWeight="Bold"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </Grid>
</UserControl>
