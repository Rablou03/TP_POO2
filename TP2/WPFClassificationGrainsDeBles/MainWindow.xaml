<Window x:Class="WPFClassificationGrainsDeBles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:WPFClassificationGrainsDeBles.ViewModels"
        Title="Classification des grains de blé - k-NN"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border Background="#2C3E50" Grid.Column="0">
            <StackPanel Margin="10,20,10,20">

                <TextBlock Text="📊 k-NN CLASSIFIER" 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 30"/>

                <Button Content="1 - Importer données" 
                        Command="{Binding ImportCommand}"
                        Background="#3498DB"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="40"
                        Margin="0 5"/>

                <Button Content="2 - Choisir k" 
                        Command="{Binding ShowKConfigCommand}"
                        Background="#3498DB"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="40"
                        Margin="0 5"/>

                <Button Content="3 - Choisir distance" 
                        Command="{Binding ShowDistanceConfigCommand}"
                        Background="#3498DB"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="40"
                        Margin="0 5"/>

                <Button Content="4 - Entraîner modèle" 
                        Command="{Binding TrainCommand}"
                        Background="#E67E22"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="40"
                        Margin="0 5"/>

                <Button Content="5 - Tester modèle" 
                        Command="{Binding TestCommand}"
                        Background="#E67E22"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="40"
                        Margin="0 5"/>

                <Separator Background="#7F8C8D" Margin="0 15"/>

                <Button Content="6 - Quitter" 
                        Command="{Binding QuitCommand}"
                        Background="#E74C3C"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="40"
                        Margin="0 5"/>

                <Border Background="#34495E" 
                        CornerRadius="5" 
                        Margin="0 20 0 0" 
                        Padding="8">
                    <TextBlock Text="{Binding ImportStatus}" 
                               Foreground="#ECF0F1" 
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <TextBlock Text="{Binding CurrentTitle}"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2C3E50"
                           Margin="0 0 0 20"/>

                <!-- 1. IMPORTATION -->
                <GroupBox Header="📁 1. Importer les données" 
                          Visibility="{Binding ShowImport}">
                    <StackPanel Margin="10">
                        <TextBlock Text="Fichier d'entraînement (train.csv):" FontWeight="Bold"/>
                        <Grid Margin="0 5 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TrainPath}" IsReadOnly="True" Background="#F5F5F5"/>
                            <Button Content="Parcourir" Command="{Binding BrowseTrainCommand}" Grid.Column="1" Margin="5,0,0,0"/>
                        </Grid>

                        <TextBlock Text="Fichier de test (test.csv):" FontWeight="Bold"/>
                        <Grid Margin="0 5 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TestPath}" IsReadOnly="True" Background="#F5F5F5"/>
                            <Button Content="Parcourir" Command="{Binding BrowseTestCommand}" Grid.Column="1" Margin="5,0,0,0"/>
                        </Grid>

                        <Button Content="🚀 Importer les données" 
                                Command="{Binding ImportCommand}"
                                Height="35"
                                Background="#28A745"
                                Foreground="White"
                                FontWeight="Bold"
                                Margin="0 10"/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. CONFIGURATION K -->
                <GroupBox Header="🔢 2. Choisir la valeur de k" 
                          Visibility="{Binding ShowKConfig}">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="k = " FontSize="18" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding KValue, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="80" 
                                     Height="40"
                                     TextAlignment="Center"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     Margin="10 0"/>
                        </StackPanel>
                        <TextBlock Text="(valeur entre 1 et 30)" 
                                   FontSize="12" 
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0 10"/>
                        <Slider Minimum="1" Maximum="30" 
                                Value="{Binding KValue}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Margin="0 10"/>
                        <Button Content="✅ Valider k" 
                                Command="{Binding ValidateKCommand}"
                                Height="35"
                                Background="#3498DB"
                                Foreground="White"
                                Margin="0 10"/>
                    </StackPanel>
                </GroupBox>

                <!-- 3. CONFIGURATION DISTANCE -->
                <GroupBox Header="📏 3. Choisir la distance" 
                          Visibility="{Binding ShowDistanceConfig}">
                    <StackPanel Margin="10">
                        <RadioButton Content="📐 Euclidienne (√∑(xi-yi)²)"
                                     IsChecked="{Binding IsEuclidienne}"
                                     Margin="0 5"/>
                        <RadioButton Content="📏 Manhattan (∑|xi-yi|)"
                                     IsChecked="{Binding IsManhattan}"
                                     Margin="0 5"/>
                        <Button Content="✅ Valider la distance" 
                                Command="{Binding ValidateDistanceCommand}"
                                Height="35"
                                Background="#3498DB"
                                Foreground="White"
                                Margin="0 15 0 0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 4 & 5. ENTRAINER ET TESTER -->
                <GroupBox Header="🎯 4. Entraîner et 5. Tester le modèle" 
                          Visibility="{Binding ShowTrainTest}">
                    <StackPanel Margin="10">
                        <Button Content="🚂 Entraîner le modèle" 
                                Command="{Binding TrainCommand}"
                                Height="40"
                                Background="#E67E22"
                                Foreground="White"
                                FontWeight="Bold"
                                Margin="0 5"/>
                        <Button Content="🧪 Tester le modèle" 
                                Command="{Binding TestCommand}"
                                Height="40"
                                Background="#E67E22"
                                Foreground="White"
                                FontWeight="Bold"
                                Margin="0 5"/>
                    </StackPanel>
                </GroupBox>

                <!-- RÉSULTATS -->
                <GroupBox Header="📊 Résultats" Margin="0 15 0 0">
                    <TextBox Text="{Binding ResultText}"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             MinHeight="200"
                             MaxHeight="300"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             Background="#F9F9F9"
                             Padding="10"/>
                </GroupBox>

                <!-- HISTORIQUE -->
                <GroupBox Header="📜 Historique des expériences" Margin="0 15 0 0">
                    <ListBox ItemsSource="{Binding HistoriqueList}"
                             MinHeight="150"
                             MaxHeight="200"
                             Margin="5"/>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>