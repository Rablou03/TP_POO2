<Window x:Class="WPFClassificationGrainsDeBles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:WPFClassificationGrainsDeBles.ViewModels"
        Title="Classification des grains de blé - k-NN"
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border BorderBrush="#CCCCCC" BorderThickness="0,0,1,0" Grid.Column="0">
            <StackPanel Margin="10">
                <TextBlock Text="MENU" 
                           FontSize="16" 
                           FontWeight="Bold"
                           Margin="0 0 0 20"/>

                <Button Content="1 - Importer données" 
                        Command="{Binding ImportCommand}"
                        Height="35"
                        Margin="0 3"/>

                <Button Content="2 - Choisir k" 
                        Command="{Binding ShowKConfigCommand}"
                        Height="35"
                        Margin="0 3"/>

                <Button Content="3 - Choisir distance" 
                        Command="{Binding ShowDistanceConfigCommand}"
                        Height="35"
                        Margin="0 3"/>

                <Button Content="4 - Entraîner modèle" 
                        Command="{Binding TrainCommand}"
                        Height="35"
                        Margin="0 3"/>

                <Button Content="5 - Tester modèle" 
                        Command="{Binding TestCommand}"
                        Height="35"
                        Margin="0 3"/>

                <Separator Margin="0 10"/>

                <Button Content="6 - Quitter" 
                        Command="{Binding QuitCommand}"
                        Height="35"
                        Margin="0 3"/>

                <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="0 20 0 0" Padding="5">
                    <TextBlock Text="{Binding ImportStatus}" 
                               FontSize="11"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15">

                <TextBlock Text="{Binding CurrentTitle}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 15"/>

                <!-- 1. IMPORTATION -->
                <GroupBox Header="1. Importer les données" 
                          Visibility="{Binding ShowImport}">
                    <StackPanel Margin="10">
                        <TextBlock Text="Fichier d'entraînement (train.csv):" FontWeight="Bold"/>
                        <Grid Margin="0 5 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TrainPath}" IsReadOnly="True"/>
                            <Button Content="Parcourir" Command="{Binding BrowseTrainCommand}" Grid.Column="1" Margin="5,0,0,0" Width="80"/>
                        </Grid>

                        <TextBlock Text="Fichier de test (test.csv):" FontWeight="Bold"/>
                        <Grid Margin="0 5 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TestPath}" IsReadOnly="True"/>
                            <Button Content="Parcourir" Command="{Binding BrowseTestCommand}" Grid.Column="1" Margin="5,0,0,0" Width="80"/>
                        </Grid>

                        <Button Content="Importer les données" 
                                Command="{Binding ImportCommand}"
                                Height="35"
                                Margin="0 10"/>
                    </StackPanel>
                </GroupBox>

                <!-- 2. CONFIGURATION K -->
                <GroupBox Header="2. Choisir la valeur de k" 
                          Visibility="{Binding ShowKConfig}">
                    <StackPanel Margin="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="k = " FontSize="16" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding KValue, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="60" 
                                     Height="30"
                                     TextAlignment="Center"
                                     Margin="10 0"/>
                        </StackPanel>
                        <TextBlock Text="(valeur entre 1 et 30)" 
                                   FontSize="11" 
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0 5"/>
                        <Button Content="Valider k" 
                                Command="{Binding ValidateKCommand}"
                                Height="30"
                                Margin="0 10"/>
                    </StackPanel>
                </GroupBox>

                <!-- 3. CONFIGURATION DISTANCE -->
                <GroupBox Header="3. Choisir la distance" 
                          Visibility="{Binding ShowDistanceConfig}">
                    <StackPanel Margin="10">
                        <RadioButton Content="Euclidienne"
                                     IsChecked="{Binding IsEuclidienne}"
                                     Margin="0 5"/>
                        <RadioButton Content="Manhattan"
                                     IsChecked="{Binding IsManhattan}"
                                     Margin="0 5"/>
                        <Button Content="Valider la distance" 
                                Command="{Binding ValidateDistanceCommand}"
                                Height="30"
                                Margin="0 15 0 0"/>
                    </StackPanel>
                </GroupBox>

                <!-- 4 & 5. ENTRAINER ET TESTER -->
                <GroupBox Header="4. Entraîner et 5. Tester le modèle" 
                          Visibility="{Binding ShowTrainTest}">
                    <StackPanel Margin="10">
                        <Button Content="Entraîner le modèle" 
                                Command="{Binding TrainCommand}"
                                Height="35"
                                Margin="0 5"/>
                        <Button Content="Tester le modèle" 
                                Command="{Binding TestCommand}"
                                Height="35"
                                Margin="0 5"/>
                    </StackPanel>
                </GroupBox>

                <!-- RÉSULTATS -->
                <GroupBox Header="Résultats" Margin="0 15 0 0">
                    <TextBox Text="{Binding ResultText}"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             MinHeight="200"
                             MaxHeight="300"
                             VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             Padding="10"/>
                </GroupBox>

                <!-- HISTORIQUE -->
                <GroupBox Header="Historique des expériences" Margin="0 15 0 0">
                    <ListBox ItemsSource="{Binding HistoriqueList}"
                             MinHeight="150"
                             MaxHeight="200"
                             Margin="5"/>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>