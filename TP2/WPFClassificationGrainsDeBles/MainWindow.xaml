<Window x:Class="WPFClassificationGrainsDeBles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:WPFClassificationGrainsDeBles.ViewModels"
        Title="Classification des grains de blé"
        Height="600" Width="1000">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU LATERAL -->
        <Border Background="#EEE" Padding="20" Grid.Column="0">
            <StackPanel>

                <TextBlock Text="Navigation"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0 0 0 20"/>

                <Button Content="Importer les données"
                        Command="{Binding NavigateToImportCommand}"
                        Height="35" Margin="0 5"/>

                <Button Content="Configuration"
                        Command="{Binding NavigateToConfigCommand}"
                        Height="35" Margin="0 5"/>

                <Button Content="Classification"
                        Command="{Binding NavigateToClassificationCommand}"
                        Height="35" Margin="0 5"/>

                <Button Content="Historique"
                        Command="{Binding NavigateToHistoriqueCommand}"
                        Height="35" Margin="0 5"/>

                <Button Content="Quitter"
                        Command="{Binding QuitCommand}"
                        Height="35" Margin="0 20 0 0"/>
            </StackPanel>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <Grid Grid.Column="1" Margin="20">
            <StackPanel HorizontalAlignment="Center" Width="700">

                <TextBlock Text="{Binding CurrentViewTitle}"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25"/>

                <ContentControl Content="{Binding CurrentView}"/>

            </StackPanel>
        </Grid>

    </Grid>
</Window>
